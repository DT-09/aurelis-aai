// api/setup.js
async function onRequestPost2({ request, env }) {
  const b = await request.json();
  const count = await env.DB.prepare("SELECT COUNT(*) c FROM users").first();
  if (Number(count.c) > 0) return json({ error: "ALREADY_INITIALIZED" }, 409);
  if (!b.email || !b.password || !b.name) return json({ error: "email,password,name required" }, 400);
  const tenant = id("ten"), user = id("usr");
  await env.DB.batch([env.DB.prepare("INSERT INTO tenants VALUES(?,?,?,?)").bind(tenant, b.name, "ACTIVE", now()), env.DB.prepare("INSERT INTO users VALUES(?,?,?,?,?,?)").bind(user, tenant, String(b.email).toLowerCase(), "OWNER", await hashSecret(b.password), now()), env.DB.prepare("INSERT INTO entitlements VALUES(?,?,?)").bind(tenant, "assurance", "ACTIVE")]);
  return json({ ok: true, tenantId: tenant, userId: user, note: "Store these credentials securely. This setup endpoint is disabled after initialization." });
}
__name(onRequestPost2, "onRequestPost");

// api/client.js
async function onRequest({ request, env }) {
  const s = await requireSession(request, env, ["OWNER", "OPERATOR", "CLIENT"]);
  if (!s) return json({ error: "AUTHENTICATION_REQUIRED" }, 401);
  if (request.method === "GET") {
    const t = await env.DB.prepare("SELECT id,name,status FROM tenants WHERE id=?").bind(s.tenant_id).first();
    const e = await env.DB.prepare('SELECT domain,status FROM entitlements WHERE tenant_id=? AND status="ACTIVE"').bind(s.tenant_id).all();
    const c = await env.DB.prepare("SELECT COUNT(*) c FROM changes WHERE tenant_id=?").bind(s.tenant_id).first();
    return json({ tenant: t, entitlements: e.results, changes: Number(c.c) });
  }
  return json({ error: "METHOD_NOT_ALLOWED" }, 405);
}
__name(onRequest, "onRequest");

